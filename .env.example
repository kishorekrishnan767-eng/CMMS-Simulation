# Copied to backend/.env by `tasks.py setup`. Never commit real secrets.
# SQLite by default (WAL mode). For Postgres: postgresql+psycopg://twin:twin@localhost:5432/twincmms
DATABASE_URL=sqlite:///./twincmms.db
JWT_SECRET=change-me-dev-only-secret-at-least-32-bytes-long
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
# Start the simulation loop automatically when the backend boots
SIM_AUTOSTART=false
